# Server Configuration
PORT = 8000
NODE_ENV = development

# Frontend Configuration
ORIGIN = ["http://localhost:3000", "http://localhost:3001"]

# Database Configuration
Mongo_URI = mongodb+srv://<username>:<password>@cluster0.mongodb.net/Lms

# Cloudinary Configuration
CLOUD_NAME = <your_cloud_name>
CLOUD_API = <your_cloud_api_key>
CLOUD_SECRET = <your_cloud_api_secret>

# Redis Configuration
REDIS_URL = rediss://default:<password>@<host>:<port>

# Authentication Secrets
ACTIVATION_SECRET = <your_activation_secret>
ACCESS_TOKEN_SECRET = <your_access_token_secret>
REFRESH_TOKEN_SECRET = <your_refresh_token_secret>

# Token Expiration (in minutes/days as per your logic)
ACCESS_TOKEN_EXPIRE = 1
REFRESH_TOKEN_EXPIRE = 2

# SMTP Configuration (Email)
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_SERVICE = gmail
SMTP_MAIL = <your_email@gmail.com>
SMTP_PASSWORD = <your_app_password>

# Payment Gateway (Razorpay)
RAZORPAY_API_KEY = <your_razorpay_key>
RAZORPAY_API_SECRET = <your_razorpay_secret>
